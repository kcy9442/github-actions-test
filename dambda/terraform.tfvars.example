# terraform.tfvars
# 이 파일을 복사해서 terraform.tfvars로 만들고 값을 채워넣기 (terraform.tfvars는 gitignore됨)
aws_region      = "ap-northeast-2"
region_name     = "my-app-dev"
vpc_cidr        = "10.0.0.0/16"
public_subnets  = ["10.0.1.0/24", "10.0.2.0/24"]
private_subnets = ["10.0.10.0/24", "10.0.11.0/24"]
container_port  = 80

# CloudWatch 경보 SNS 이메일 구독 주소
cloudwatch_alarm_email = "wisdompjt@gmail.com"

# Bedrock 상품 추천/질의 모델. Tavily 키는 tfvars에 저장하지 말고 GitHub Secret으로 주입
bedrock_model_id         = "apac.amazon.nova-micro-v1:0"
tavily_api_key           = ""
admin_notification_email = ""

# Route 53 웹 도메인
web_domain_name    = "shinning.cloud"
web_domain_aliases = ["www.shinning.cloud"]

# 미국(us-east-1) 리전
us_aws_region      = "us-east-1"
us_region_name     = "my-app-dev-us"
us_vpc_cidr        = "10.1.0.0/16"
us_public_subnets  = ["10.1.1.0/24", "10.1.2.0/24"]
us_private_subnets = ["10.1.10.0/24", "10.1.11.0/24"]

# Amazon Managed Service for Prometheus를 콘솔에서 만든 뒤 활성화
enable_prometheus            = false
prometheus_workspace_arn     = ""
prometheus_remote_write_url  = ""
